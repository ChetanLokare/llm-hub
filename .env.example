# Copy to ".env" ONLY if you prefer environment variables over the in-app Settings screen.
# The backend reads the process environment; it does not load .env files by itself, so either
# set these in your shell, or use an editor/tool that loads .env. Never commit the real file.

# --- Provider API keys (any you leave out are simply unavailable) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# --- One custom OpenAI-compatible endpoint, e.g. a local Ollama ---
# LLMHUB_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# LLMHUB_COMPATIBLE_LABEL=Ollama (local)
# LLMHUB_COMPATIBLE_API_KEY=ollama
# LLMHUB_COMPATIBLE_MODELS=qwen3:4b,gemma3:4b

# --- Where chats, usage and capability results are stored (default: ~/.llm_hub/telemetry.sqlite3) ---
# LLMHUB_TELEMETRY_DB=
